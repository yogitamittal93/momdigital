{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:mobile": "cross-env EXPORT_MOBILE=true next build",
    "build:android": "env-cmd -f .env.mobile cross-env EXPORT_MOBILE=true next build",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "npx cap sync",
    "cap:copy": "npm run build:android && npx cap copy",
    "cap:android": "npm run build:android && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build:mobile && npx cap sync ios && npx cap open ios",
    "cap:run:android": "npm run build:android && npx cap sync android && npx cap run android",
    "cap:run:ios": "npm run build:mobile && npx cap sync ios && npx cap run ios"
  },
  "dependencies": {
