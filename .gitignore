# --- Monorepo Root Ignores ---
node_modules/
.env
.env.*
!.env.example
*.log
.DS_Store

# --- Docker & Infrastructure ---
.docker/
postgres_data/
docker-compose.override.yml

# --- Backend (NestJS & Prisma) ---
api/node_modules/
api/dist/
api/coverage/
api/.prisma/
# Migration SQL files are intentionally committed — do NOT ignore them
# # Migration files MUST be committed — do not ignore them
# api/prisma/migrations/*.sql
# Keep migrations but ignore the sqlite db if you ever use it locally
api/*.db
api/*.db-journal

# --- Frontend (Next.js) ---
web/node_modules/
web/.next/
web/out/
web/build/
web/.vercel
web/*.tsbuildinfo
web/next-env.d.ts

ml_service/node_modules/
ml_service/dist/
ml_service/data/
ml_service/.env
ml_service/.env.*
ml_service/.pytest_cache/
ml_service/venv/
ml_service/__pycache__/
ml_service/**/*.py[cod]
ml_service/*.log
ml_service/matrny_db/

# --- Playwright ---
test-results/
playwright-report/
playwright/.auth/

# --- IDE & System ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.eslintcache
# Android signing secrets � NEVER commit these
web/android/keystore.properties
web/android/app/*.jks
web/android/app/*.keystore
