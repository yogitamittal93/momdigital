# Database (Supabase PostgreSQL)
# DATABASE_URL = Transaction pooler URL (port 6543) — use at scale
# DIRECT_URL   = Direct connection (port 5432) — always needed for migrations
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Auth
JWT_ACCESS_SECRET=generate_with_openssl_rand_base64_32
JWT_REFRESH_SECRET=generate_with_openssl_rand_base64_32
JWT_SECRET=generate_with_openssl_rand_base64_32

# ML Service
GROQ_API_KEY=gsk_your_key_here

# App
NODE_ENV=production
PORT=3001
CLIENT_URL=https://your-domain.com
CLIENT_URLS=https://your-domain.com,https://www.your-domain.com

# Redis
REDIS_URL=redis://localhost:6379

# Storage
SCAN_UPLOAD_DIR=uploads/scans
SCAN_MAX_FILE_BYTES=10485760

# ML service URL (NestJS → Flask)
ML_SERVICE_URL=http://127.0.0.1:5000
